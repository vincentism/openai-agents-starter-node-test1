# LLM Gateway Configuration
# Required: OpenAI-compatible LLM API credentials
AI_GATEWAY_API_KEY=your-api-key
AI_GATEWAY_BASE_URL=https://your-openai-compatible-endpoint/v1

# Optional: model name (defaults to @makers/deepseek-v4-flash)
AI_GATEWAY_MODEL=@makers/deepseek-v4-flash

# Frontend Agent Auth (JWT)
# The agent backend is protected by JWT auth (edgeone.json -> agents.auth).
# The edge controller requires `Authorization: Bearer <jwt>` on every agent
# route; requests without it are rejected with "missing-bearer".
#
# Provide a JWT signed by the private key matching a public key in
# edgeone.json `agents.auth.verificationKeys` (asymmetric, e.g. RS256).
# Exposed to the browser at build time via Vite's VITE_ prefix — only put a
# SHORT-LIVED token here, never the signing private key.
VITE_AGENT_TOKEN=your-agent-jwt
